generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Acceso {
  id Int @id @default(autoincrement())
  usuarioAsignado String
  tokenLlave String @unique
  creadoEn DateTime @default(now())
}

model Usuario {
  id Int @id @default(autoincrement())
  nombre String?
  email String @unique
  passwordHash String
  token_acceso String? @unique
}